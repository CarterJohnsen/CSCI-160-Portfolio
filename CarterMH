package CarterMH;

import java.util.Random;
import java.util.Scanner;
import java.util.ArrayList;

public class HallMonty {
    public static void main(String[] args){
        Scanner input = new Scanner(System.in);
        int simulations;
        int choice;
        int wins=0;

        System.out.println("How many simulations to run?");
        simulations=input.nextInt();
        System.out.println("Enter 1 for switching or 0 for staying");
        choice= input.nextInt();

        int max= 3;
        int min= 1;
        Random r=new Random();

        //Choose the prize and the guess
        for(int i=0; i<simulations; i++){
            int prize= r.nextInt(max-min+1)+min;
            int goat1 = (prize+1)%3;
            if(goat1==0){
                goat1=3;
            }
            int goat2= (prize+2)%3;
            if(goat2==0){
                goat2 =3;
            }
            int guess =r.nextInt(max-min +1)+min;
            //System.out.println("P="+prize+" G="+goat1+" G="+goat2+" ?="+guess);

            //if they stick
            if(choice == 0 &&prize==guess){
                wins++;
            }
            //if they switch
            if(choice==1){
                if(guess!=prize){// they picked the wronge door
                    guess=prize;// switched to the prize
                }else if(guess==prize){
                    guess=goat1;
                }
                if(prize==guess){
                    wins++;
                }
            }
        }
        double perc = ((wins*1.0)/(simulations*1.0))*100;
        if (choice==0){
            System.out.println("You chose not to switch");
        }else{
            System.out.println("You chose to switch");
        }    
        
        System.out.println("out of "+ simulations + " trails, there were "+wins+" wins");
        System.out.println("The percentage of wins is "+perc);

    }
}
